# Copy thành .env rồi sửa. .env đã nằm trong .gitignore.
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
# Postgres local chạy bằng docker compose. Mật khẩu giả.
# Dạng: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://todo_user:todo_pass_local@localhost:5432/todo_db
DB_MAX_CONNECTIONS=10
