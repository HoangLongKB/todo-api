# Copy thành .env rồi sửa. .env đã nằm trong .gitignore.
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
# Postgres local chạy bằng docker compose. Mật khẩu giả.
# Dạng: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://todo_user:todo_pass_local@localhost:5432/todo_db
DB_MAX_CONNECTIONS=10
# Redis local qua docker compose. Bỏ trống thì chạy không cache.
REDIS_URL=redis://localhost:6379
# Firebase / GCP project. Local dùng ADC (gcloud auth application-default login), không file key.
FIREBASE_PROJECT_ID=todo-lab-hoanglong
# Secret giả cho máy gọi máy. Trên cloud lấy từ Secret Manager.
WEBHOOK_SECRET=local-webhook-secret-doi-sau
# Origin của web được phép gọi API (CORS), cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000
